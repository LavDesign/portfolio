---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

import MenuOverlay from "../components/MenuOverlay.astro";
import RailNav from "../components/RailNav.astro";
import TopBar from "../components/TopBar.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only bg-brand px-4 py-3 font-medium text-on-brand focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>

    <RailNav />
    <TopBar />

    <main id="main" tabindex="-1" class="outline-none lg:pl-18">
      <slot />
    </main>

    <MenuOverlay />

    <script>
      import { initMenu } from "../scripts/menu.js";

      initMenu();
    </script>
  </body>
</html>
