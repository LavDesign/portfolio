---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

// Preloading the Latin subsets (used on every page) removes the font-swap layout
// shift Lighthouse measured on /about. ?url resolves to the same hashed file as @font-face.
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

import MenuOverlay from "../components/MenuOverlay.astro";
import RailNav from "../components/RailNav.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TopBar from "../components/TopBar.astro";
import { owner } from "../data/site.js";

// `siteHeader={false}` lets a page place SiteHeader itself (the Home puts it inside the hero).
const { title, description, noindex = false, siteHeader = true } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121212" />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- TODO (M7): canonical link and sitemap once the production domain is set. -->

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- TODO (M7): make og:image absolute (https://<domain>/og.png) once the domain is set. -->
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${owner.brand} — ${owner.jobTitle}`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href={geistLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistMonoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only bg-brand px-4 py-3 font-medium text-on-brand focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>

    <RailNav />
    <TopBar />

    <main id="main" tabindex="-1" class="outline-none lg:pl-18">
      {siteHeader && <SiteHeader />}
      <slot />
    </main>

    <MenuOverlay />

    <script>
      import { initMenuIcon } from "../scripts/menu-icon.js";
      import { initMenu } from "../scripts/menu.js";

      initMenuIcon();
      initMenu();
    </script>
  </body>
</html>
