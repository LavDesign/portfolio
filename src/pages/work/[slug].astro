---
import { getEntry, render } from "astro:content";

import CaseGallery from "../../components/CaseGallery.astro";
import LinkArrow from "../../components/LinkArrow.astro";
import Screenshot from "../../components/Screenshot.astro";
import StatusTag from "../../components/StatusTag.astro";
import { nextProject, projects } from "../../data/projects.js";
import { ownerWithBrand, pageTitle } from "../../data/site.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatIndex } from "../../scripts/chapter-utils.js";
import { opensInNewTab } from "../../scripts/link-arrow.js";

// One page per project in projects.js, which owns the order and the card data.
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { index },
  }));
}

const { index } = Astro.props;
const project = projects[index];
const next = nextProject(project.slug);

const entry = await getEntry("work", project.slug);
if (!entry) {
  throw new Error(`Missing case study: src/content/work/${project.slug}.mdx`);
}
const { Content } = await render(entry);
const { role, year, links, credits } = entry.data;
---

<BaseLayout
  title={pageTitle(project.name)}
  description={`Case study by ${ownerWithBrand}. ${project.description}`}
>
  <article class="px-4 py-16 md:px-6 lg:px-12 xl:px-18">
    <header>
      <p class="font-mono text-[13px] tracking-[0.08em] text-brand">
        CASE STUDY — {formatIndex(index)}
      </p>
      <h1 class="mt-6 text-[clamp(48px,10vw,144px)] leading-[0.88] font-bold tracking-[-0.05em] uppercase">
        {project.name}
      </h1>
      <p class="mt-8">
        <StatusTag status={project.status} label={project.statusLabel} />
      </p>
      <p class="mt-4 max-w-[720px] text-[20px] leading-[32px] text-ink-muted">
        {project.description}
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <li class="border border-line px-2 py-1 font-mono text-xs text-ink-muted">
            {tag}
          </li>
        ))}
      </ul>
    </header>

    <!-- Empty fields show "—": nothing here is filled in without approved data. -->
    <dl class="mt-10 grid gap-6 border-y border-line py-6 font-mono text-[13px] tracking-[0.08em] md:grid-cols-3">
      <div>
        <dt class="text-ink-subtle">ROLE</dt>
        <dd class="mt-2">{role || "—"}</dd>
      </div>
      <div>
        <dt class="text-ink-subtle">YEAR</dt>
        <dd class="mt-2">{year || "—"}</dd>
      </div>
      <div>
        <dt class="text-ink-subtle">LINKS</dt>
        <dd class="mt-2">
          {links.length > 0 ? (
            <ul class="flex flex-wrap gap-x-6 gap-y-2">
              {links.map((link) => (
                <li>
                  {/* Links to other sites open in a new tab; the hidden note tells screen readers. */}
                  <a
                    href={link.href}
                    class="underline decoration-brand underline-offset-4 hover:text-brand-hover"
                    {...(opensInNewTab(link.href) && {
                      target: "_blank",
                      rel: "noopener",
                    })}
                  >
                    {link.label}
                    {opensInNewTab(link.href) && (
                      <span class="sr-only"> (opens in a new tab)</span>
                    )}{" "}
                    <LinkArrow href={link.href} />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            "—"
          )}
        </dd>
      </div>
      {credits && (
        <div class="md:col-span-3">
          <dt class="text-ink-subtle">CREDITS</dt>
          <dd class="mt-2">{credits}</dd>
        </div>
      )}
    </dl>

    {project.gallery ? (
      <CaseGallery items={project.gallery} class="mt-12" />
    ) : (
      <Screenshot
        image={project.image}
        screens={project.screens}
        sizes="100vw"
        class="mt-12"
      />
    )}
    {project.captureNote && (
      <p class="mt-3 font-mono text-[13px] tracking-[0.08em] text-ink-subtle">
        {project.captureNote}
      </p>
    )}

    <Content />

    <nav
      aria-label="Case studies"
      class="mt-24 flex flex-col gap-8 border-t border-line pt-10 md:flex-row md:items-end md:justify-between"
    >
      <a href={next.caseUrl} class="group block">
        <span class="block font-mono text-[13px] tracking-[0.08em] text-ink-muted">
          Next project <LinkArrow href={next.caseUrl} />
        </span>
        <span class="mt-3 block text-[32px] leading-[1.05] font-bold tracking-[-0.04em] uppercase group-hover:text-ink-muted">
          {next.name}
        </span>
      </a>
      <a
        href="/work"
        class="font-mono text-[13px] tracking-[0.08em] underline decoration-brand underline-offset-4 hover:text-brand-hover"
      >
        <LinkArrow href="/work" back /> All work
      </a>
    </nav>
  </article>
</BaseLayout>
