---
import LinkArrow from "../components/LinkArrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — LAV Design"
  description="This page doesn't exist."
  noindex
>
  <div class="px-4 py-16 md:px-6 lg:px-12 xl:px-18">
    <h1 class="text-[clamp(120px,30vw,400px)] leading-[0.8] font-bold tracking-[-0.06em]">
      404
    </h1>
    <p class="mt-10 border-t border-line pt-8 text-[22px] leading-[30px] font-semibold">
      This page doesn't exist.
    </p>
    <a
      href="/"
      class="mt-6 inline-block font-semibold underline decoration-brand decoration-2 underline-offset-[6px] hover:text-brand-hover"
    >
      Back to the Home <LinkArrow href="/" />
    </a>
  </div>
</BaseLayout>
