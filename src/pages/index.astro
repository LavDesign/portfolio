---
import Chapters from "../components/Chapters.astro";
import Hero from "../components/Hero.astro";
import {
  ownerWithBrand,
  owner,
  pageTitle,
  personSchema,
} from "../data/site.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const schema = JSON.stringify(personSchema(Astro.site?.href));
---

<BaseLayout
  siteHeader={false}
  title={pageTitle()}
  description={`Portfolio of ${ownerWithBrand}, ${owner.jobTitle}.`}
>
  <script slot="head" type="application/ld+json" set:html={schema} />
  <Hero />
  <Chapters />
</BaseLayout>
