---
import { projects } from "../data/projects.js";
import { formatIndex } from "../scripts/chapter-utils.js";
import Screenshot from "./Screenshot.astro";
import StatusTag from "./StatusTag.astro";

// Reads the project from the data so its fields stay typed (props are untyped JS).
const { index } = Astro.props;
const project = projects[index];
---

<a href={project.caseUrl} class="group block">
  <Screenshot
    image={project.image}
    screens={project.screens}
    hoverScroll
    sizes="(min-width: 768px) 50vw, 100vw"
    class="transition-[translate,border-color] duration-200 ease-out group-hover:border-line-strong motion-safe:group-hover:-translate-y-0.5"
  />
  <p class="mt-5 flex items-center gap-2 font-mono text-xs tracking-[0.08em]">
    <span>{formatIndex(index)} ·</span>
    <StatusTag status={project.status} label={project.statusLabel} />
  </p>
  <h2 class="mt-3 text-[32px] leading-[1.05] font-bold tracking-[-0.04em] uppercase">
    {project.name}
  </h2>
  <ul class="mt-4 flex flex-wrap gap-2">
    {project.tags.map((tag) => (
      <li class="border border-line px-2 py-1 font-mono text-xs text-ink-muted">
        {tag}
      </li>
    ))}
  </ul>
</a>
