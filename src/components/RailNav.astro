---
import { owner } from "../data/site.js";
import MenuIcon from "./MenuIcon.astro";
---

<header class="fixed inset-y-0 left-0 z-40 hidden w-18 flex-col items-center border-r border-line bg-bg lg:flex">
  <!-- w-full (71px) + the rail's 1px border = the 72px cell that MenuOverlay's close button covers. -->
  <button
    type="button"
    class="flex h-18 w-full shrink-0 items-center justify-center border-b border-line"
    aria-label="Open menu"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-open
  >
    <MenuIcon />
  </button>

  <p class="mt-8 rotate-180 font-mono text-xs tracking-[0.12em] text-ink-muted [writing-mode:vertical-rl]">
    PORTFOLIO — 2026
  </p>

  <div class="mt-auto flex flex-col items-center pb-8">
    <!-- On the Home, rail-status.js swaps this for "CH.n / 4" (ink, digit in brand) while a chapter is in view. -->
    <p
      class="rotate-180 font-mono text-xs text-ink-muted uppercase transition-[color] duration-200 ease-out [writing-mode:vertical-rl] data-active:text-ink"
      data-rail-status
    >
      © 2026 {owner.name}
    </p>
  </div>
</header>
