---
import MenuIcon from "./MenuIcon.astro";
---

<header class="fixed inset-y-0 left-0 z-40 hidden w-18 flex-col items-center border-r border-line bg-bg lg:flex">
  <button
    type="button"
    class="flex size-18 shrink-0 items-center justify-center border-b border-line"
    aria-label="Open menu"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-open
  >
    <MenuIcon />
  </button>

  <p class="mt-8 rotate-180 font-mono text-xs tracking-[0.12em] text-ink-muted [writing-mode:vertical-rl]">
    PORTFOLIO — 2026
  </p>

  <div class="mt-auto flex flex-col items-center gap-6 pb-8">
    <p class="rotate-180 text-base font-bold [writing-mode:vertical-rl]">
      LAV DESIGN
    </p>
    <!-- On the Home, chapters.js swaps this for "CH.n / 4" while a chapter is in view. -->
    <p
      class="rotate-180 font-mono text-xs text-ink-muted [writing-mode:vertical-rl]"
      data-rail-status
    >
      © 2026
    </p>
  </div>
</header>
