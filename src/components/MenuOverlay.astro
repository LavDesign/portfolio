---
import MenuLockup from "../assets/brand/lav-lockup-white-notag.svg";
import { nav, social } from "../data/site.js";
import MenuIcon from "./MenuIcon.astro";
import SocialLink from "./SocialLink.astro";

// Exploration for review: the white lockup in the open menu. To remove it, set this to
// false (or delete this flag, the import above and the showLockup block).
const showLockup = true;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!--
  Shares the page grid. Desktop: the dialog is transparent over the rail; a close button sits
  exactly on the rail's menu cell, and the panel's 72px top row mirrors SiteHeader (white lockup
  in the dark lockup's place, CLOSE + X on the right). Mobile: the top row mirrors the 64px top bar.
-->
<dialog
  id="site-menu"
  aria-label="Site menu"
  class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto border-0 bg-transparent p-0 text-ink backdrop:bg-transparent open:flex"
>
  <!-- Same spot as the button that opened the menu: the top bar's (mobile) or the rail cell (desktop). -->
  <button
    type="button"
    aria-label="Close menu"
    aria-expanded="true"
    aria-controls="site-menu"
    data-menu-close
    class="absolute top-[9.5px] right-2 z-10 flex size-11 items-center justify-center md:right-4 lg:top-0 lg:right-auto lg:left-0 lg:size-18 lg:border-r lg:border-b lg:border-line lg:bg-bg"
  >
    <!-- Starts as the menu icon and morphs into the close icon (see menu-icon.js). -->
    <MenuIcon />
  </button>

  <!-- The panel fades and rises 8px on open and close (menu.js); the button above stays put. -->
  <div
    data-menu-panel
    class="flex min-h-full w-full flex-col bg-surface lg:ml-18 lg:w-[calc(100%-4.5rem)]"
  >
    <div class="flex h-16 shrink-0 items-center justify-between border-b border-line px-4 md:px-6 lg:h-18 lg:px-12 xl:px-18">
      {showLockup ? (
        <MenuLockup aria-hidden="true" class="h-7 w-auto lg:h-10" />
      ) : (
        <span />
      )}
      <!-- One control: CLOSE and a 24px X (two crossed 2px lines) on the same axis; both turn
           brand on hover and focus. The label keeps the visible word in the accessible name. -->
      <button
        type="button"
        aria-label="Close menu"
        class="group/close -mr-2 hidden min-h-11 items-center gap-3 px-2 font-mono text-sm tracking-[0.12em] transition-[color] duration-200 ease-out hover:text-brand focus-visible:text-brand lg:inline-flex"
        data-menu-close
      >
        CLOSE
        <span aria-hidden="true" class="relative size-6 shrink-0">
          <span class="absolute top-1/2 left-1/2 h-0.5 w-6 -translate-1/2 bg-ink transition-[background-color] duration-200 ease-out group-hover/close:bg-brand group-focus-visible/close:bg-brand rotate-45"></span>
          <span class="absolute top-1/2 left-1/2 h-0.5 w-6 -translate-1/2 bg-ink transition-[background-color] duration-200 ease-out group-hover/close:bg-brand group-focus-visible/close:bg-brand -rotate-45"></span>
        </span>
      </button>
    </div>

    <!-- Centered in the space under the top row, with at least 48px of air below its border. -->
    <nav
      aria-label="Main"
      class="flex flex-1 flex-col justify-center px-4 py-12 md:px-6 lg:px-12 xl:px-18"
    >
      <ul>
        {nav.map((item, index) => {
          // Sections own their subpages: /work/<slug> marks WORK as current.
          const isCurrent =
            item.href === "/"
              ? currentPath === "/"
              : currentPath === item.href ||
                currentPath.startsWith(`${item.href}/`);
          return (
            <li class="menu-item" style={`--i: ${index}`}>
              <a
                href={item.href}
                data-menu-link
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "inline-flex items-start gap-3 transition-[color] duration-200 ease-out md:gap-5",
                  isCurrent
                    ? "text-ink"
                    : "text-line-strong hover:text-ink focus-visible:text-ink",
                ]}
              >
                <span class="pt-[0.4em] font-mono text-2xl">{item.number}</span>
                <span class="text-[clamp(56px,11vw,168px)] leading-[0.95] font-bold tracking-[-0.05em] uppercase">
                  {item.label}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <ul class="flex shrink-0 flex-wrap justify-end gap-x-6 gap-y-2 px-4 pb-8 text-base text-ink md:px-6 lg:px-12 xl:px-18">
      {social.map((link) => (
        <li>
          <SocialLink
            {...link}
            class="inline-flex min-h-11 items-center hover:text-ink-muted"
          />
        </li>
      ))}
    </ul>
  </div>
</dialog>

<style>
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] .menu-item {
      animation: menu-item-in 300ms ease-out both;
      /* Starts just after the panel begins to fade in (menu.js). */
      animation-delay: calc(80ms + var(--i) * 50ms);
    }
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
