---
import { projects } from "../data/projects.js";
import ProjectPanel from "./ProjectPanel.astro";

// Enough repetitions to span every panel at wide screens; the band clips the rest.
const band = Array.from({ length: 48 }, () => "Work").join(" ");
---

<div
  id="work"
  data-chapter
  class="horizontal:flex horizontal:h-full horizontal:flex-col"
>
  <h2 class="px-4 pt-16 font-mono text-[13px] tracking-[0.08em] text-brand uppercase md:px-6 lg:px-12 horizontal:sr-only">
    <span aria-hidden="true">Ch.1 — </span>Selected work
  </h2>

  <!-- w-0 + min-w-full: fills the chapter without widening it to the text's length. -->
  <p
    aria-hidden="true"
    class="mt-6 w-0 min-w-full shrink-0 overflow-clip border-y border-line py-3 text-[64px] leading-none font-bold whitespace-nowrap text-line uppercase horizontal:mt-0 horizontal:border-t-0"
  >
    {band}
  </p>

  <ol class="grid gap-16 px-4 pt-10 pb-24 md:grid-cols-2 md:gap-x-8 md:px-6 lg:px-12 horizontal:flex horizontal:min-h-0 horizontal:flex-1 horizontal:gap-0 horizontal:p-0">
    {projects.map((_project, index) => (
      <li class="horizontal:h-full horizontal:shrink-0">
        <ProjectPanel {index} />
      </li>
    ))}
  </ol>
</div>
