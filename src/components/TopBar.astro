---
import Lockup from "../assets/brand/lav-lockup-dark-notag.svg";
import MenuIcon from "./MenuIcon.astro";
---

<header class="sticky top-0 z-40 flex h-16 items-center justify-between border-b border-line bg-bg px-4 md:px-6 lg:hidden">
  <a href="/" aria-label="LAV Design — Home" class="flex min-h-11 items-center">
    <Lockup aria-hidden="true" class="h-7 w-auto" />
  </a>

  <button
    type="button"
    class="-mr-2 flex size-11 items-center justify-center"
    aria-label="Open menu"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-open
  >
    <MenuIcon />
  </button>
</header>
